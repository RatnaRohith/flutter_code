iv) Container widget

Code:
// Import Flutter Material Design widgets
import 'package:flutter/material.dart';

// Starting point of the Dart program
void main() {
  // Start the Flutter application
  runApp(const MyApp());
}

// Create the main application widget
class MyApp extends StatelessWidget {
  
  // Constructor
  const MyApp({super.key});

  // Build the user interface
  @override
  Widget build(BuildContext context) {

    // Root widget of the application
    return MaterialApp(

      // Remove DEBUG banner
      debugShowCheckedModeBanner: false,

      // Application title
      title: 'Container Widget Example',

      // Main screen
      home: Scaffold(

        // Top AppBar
        appBar: AppBar(

          // AppBar title
          title: const Text('Container Widget'),

          // AppBar background color
          backgroundColor: Colors.blue,
        ),

        // Main body
        body: Center(

          // Container/Box
          child: Container(

            // Container width
            width: 250,

            // Container height
            height: 150,

            // Space inside Container
            padding: const EdgeInsets.all(20),

            // Container decoration
            decoration: BoxDecoration(

              // Orange background
              color: Colors.orange,

              // Rounded corners
              borderRadius: BorderRadius.circular(20),

              // Black border
              border: Border.all(
                color: Colors.black,
                width: 2,
              ),

              // Shadow
              boxShadow: const [
                BoxShadow(
                  color: Colors.grey,
                  blurRadius: 10,

                  // Shadow moves right and down
                  offset: Offset(5, 5),
                ),
              ],
            ),

            // Center the text inside Container
            child: const Center(

              // Display text
              child: Text(
                'Hello Flutter!',

                // Text formatting
                style: TextStyle(
                  fontSize: 24,
                  color: Colors.white,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
          ),
        ),
      ),
    );
  }
}


